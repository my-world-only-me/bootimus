# Minimal bootimus image: static Go binary on Alpine, no shell tooling bloat.
#
# Compared to the upstream Dockerfile (debian:trixie-slim + samba + full
# postgresql-client) this image drops:
#   * samba         - only used by the optional Windows SMB unattended install
#   * postgresql-client - not needed: we run the embedded SQLite backend
# and keeps only the tools bootimus really shells out to at runtime:
#   * wimlib-imagex - Windows WIM patching / driver injection (optional path)
#   * bsdtar        - ISO extraction fallback
#   * ipmitool      - BMC power control (optional)
#
# Stage 1: build a fully static binary.
FROM --platform=$BUILDPLATFORM golang:1.27-alpine AS builder

ARG TARGETOS=linux
ARG TARGETARCH
ARG VERSION=dev

ENV CGO_ENABLED=0 \
    GOOS=${TARGETOS} \
    GOARCH=${TARGETARCH}

WORKDIR /src

# Dependency layer: cached as long as go.mod/go.sum are unchanged.
COPY go.mod go.sum ./
RUN go mod download

# Sources. `make sync-profiles` copies the profile JSONs into the two
# packages that embed them, so do it here instead of at release time.
COPY main.go ./
COPY cmd/ ./cmd/
COPY internal/ ./internal/
COPY web/ ./web/
COPY bootloaders/ ./bootloaders/
COPY raspberrypi/ ./raspberrypi/
COPY distro-profiles.json ./
COPY tools-profiles.json ./
RUN cp distro-profiles.json internal/profiles/distro-profiles.json \
 && cp tools-profiles.json internal/tools/tools-profiles.json \
 && go build -trimpath \
      -ldflags="-w -s -X bootimus/internal/server.Version=${VERSION}" \
      -o /out/bootimus .

# Stage 2: runtime. Alpine keeps the image near ~40 MB instead of ~250 MB.
FROM alpine:3.22

RUN apk add --no-cache \
      ca-certificates \
      tzdata \
      wimlib \
      libarchive-tools \
      ipmitool \
 && update-ca-certificates \
 && rm -rf /var/cache/apk/*

COPY --from=builder /out/bootimus /bootimus

# PXE stack: TFTP(69), HTTP(8080), admin UI(8081), proxyDHCP(67/4011), NBD(10809)
EXPOSE 69/udp 67/udp 4011/udp 8080/tcp 8081/tcp 10809/tcp

VOLUME ["/data"]

# bootimus writes to /data as root; no user remap to keep TFTP/DHCP ports usable.
ENTRYPOINT ["/bootimus"]
CMD ["serve"]
